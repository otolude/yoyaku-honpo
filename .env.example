# このファイルを .env へコピーし、ローカル環境に合う値を設定してください。
# .env はGit管理されません。本物のトークンや本番パスワードをこの見本へ書かないでください。

# 実行環境。開発時は development を使用します。
APP_ENV=development

# ログの詳しさ。通常は INFO のままで構いません。
LOG_LEVEL=INFO

# Phase 1では日本時間だけを使用します。この値は変更しないでください。
TIMEZONE=Asia/Tokyo

# Discord Developer Portalで発行したBotトークンを.envだけに設定します。
DISCORD_BOT_TOKEN=

# Botを利用するDiscordサーバーのIDです。
DISCORD_GUILD_ID=

# 予約を作成できるロールIDです。複数ある場合はカンマで区切ります。
# 例: 111111111111111111,222222222222222222
DISCORD_ALLOWED_ROLE_IDS=

# 通知チャンネルへ送れなかった場合にDMするBot運営者のユーザーIDです。
DISCORD_OPERATOR_USER_ID=

# 投稿失敗などを通知する、対象サーバー内のチャンネルIDです。
DISCORD_OPERATOR_CHANNEL_ID=

# WSLからDocker Composeの開発用PostgreSQLへ接続するURLです。
# 下記はローカル開発専用です。本番の認証情報を記載しないでください。
DATABASE_URL=postgresql+psycopg://discord_bot:discord_bot_dev_password@localhost:5432/discord_bot_dev

# PostgreSQL統合テスト専用URLです。アプリ本体はこの値を読みません。
# test profileの一時DBだけを指定し、discord_bot_devや本番DBを指定しないでください。
TEST_DATABASE_URL=postgresql+psycopg://discord_bot_test:discord_bot_test_password@127.0.0.1:55432/discord_bot_test

# 予約実行対象を確認する間隔（秒）です。
SCHEDULER_POLL_INTERVAL_SECONDS=10

# 1回の確認で取得する予約実行の最大件数です。
SCHEDULER_BATCH_SIZE=20

# 同時に処理するDiscord送信の最大件数です。
SCHEDULER_MAX_CONCURRENCY=5

# 送信開始前に取得した処理権が期限切れになるまでの秒数です。
SCHEDULER_PROCESSING_TIMEOUT_SECONDS=120

# 通知outboxを確認する間隔（秒）です。予約投稿の確認間隔とは独立しています。
NOTIFICATION_POLL_INTERVAL_SECONDS=10

# 1回の確認でclaimする通知の最大件数です。
NOTIFICATION_BATCH_SIZE=20

# 同時に処理する通知送信の最大件数です。
NOTIFICATION_MAX_CONCURRENCY=5

# 通知のprocessing leaseが期限切れになるまでの秒数です。
NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=120

# Phase 3 2BのProvider非依存基盤です。実Provider未接続のため安全側で無効にします。
# 回数・費用は開発・隔離テスト用の変更可能な暫定値で、販売価格や恒久上限ではありません。
AI_NAME_GENERATION_ENABLED=false
# 2C-1の初期値はdisabled。openaiへ変更しても全設定と秘密キーが揃うまで通信しません。
AI_NAME_GENERATION_PROVIDER=disabled
# AI_NAME_GENERATION_OPENAI_API_KEYは実行環境の秘密管理からだけ設定してください。
AI_NAME_GENERATION_OPENAI_MODEL=gpt-5.6-luna
AI_NAME_GENERATION_OPENAI_REASONING_EFFORT=none
AI_NAME_GENERATION_OPENAI_INPUT_PRICE_MICRO_USD_PER_MILLION_TOKENS=200000
AI_NAME_GENERATION_OPENAI_OUTPUT_PRICE_MICRO_USD_PER_MILLION_TOKENS=1200000
# 例示値。実Provider試験前に実勢為替と安全余裕を再確認してください。
AI_NAME_GENERATION_USD_JPY_RATE_MICROUNITS=150000000
AI_NAME_GENERATION_COST_SAFETY_BASIS_POINTS=12500
AI_NAME_GENERATION_MAX_INPUT_CHARACTERS=2000
AI_NAME_GENERATION_MAX_INPUT_BYTES=8000
AI_NAME_GENERATION_MAX_INPUT_TOKENS=8512
AI_NAME_GENERATION_MAX_OUTPUT_TOKENS=64
AI_NAME_GENERATION_OPENAI_CONNECT_TIMEOUT_MILLISECONDS=1000
AI_NAME_GENERATION_OPENAI_REQUEST_TIMEOUT_MILLISECONDS=4000
AI_NAME_GENERATION_POLL_INTERVAL_SECONDS=5
AI_NAME_GENERATION_TIMEOUT_SECONDS=5
AI_NAME_GENERATION_MAX_CONCURRENCY=1
AI_NAME_GENERATION_DAILY_REQUEST_LIMIT=50
AI_NAME_GENERATION_MONTHLY_REQUEST_LIMIT=500
AI_NAME_GENERATION_MONTHLY_COST_LIMIT_MICROUNITS=100000000
AI_NAME_GENERATION_COST_CURRENCY=JPY
AI_NAME_GENERATION_PROCESSING_LEASE_SECONDS=30
AI_NAME_GENERATION_JOB_RETENTION_DAYS=30
AI_NAME_GENERATION_BUDGET_RETENTION_DAYS=90
