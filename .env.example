# このファイルを .env へコピーし、ローカル環境に合う値を設定してください。
# .env はGit管理されません。本物のトークンや本番パスワードをこの見本へ書かないでください。

# 実行環境。開発時は development を使用します。
APP_ENV=development

# ログの詳しさ。通常は INFO のままで構いません。
LOG_LEVEL=INFO

# Phase 1では日本時間だけを使用します。この値は変更しないでください。
TIMEZONE=Asia/Tokyo

# Discord Developer Portalで発行したBotトークンを.envだけに設定します。
DISCORD_BOT_TOKEN=

# Botを利用するDiscordサーバーのIDです。
DISCORD_GUILD_ID=

# 予約を作成できるロールIDです。複数ある場合はカンマで区切ります。
# 例: 111111111111111111,222222222222222222
DISCORD_ALLOWED_ROLE_IDS=

# 通知チャンネルへ送れなかった場合にDMするBot運営者のユーザーIDです。
DISCORD_OPERATOR_USER_ID=

# 投稿失敗などを通知する、対象サーバー内のチャンネルIDです。
DISCORD_OPERATOR_CHANNEL_ID=

# WSLからDocker Composeの開発用PostgreSQLへ接続するURLです。
# 下記はローカル開発専用です。本番の認証情報を記載しないでください。
DATABASE_URL=postgresql+psycopg://discord_bot:discord_bot_dev_password@localhost:5432/discord_bot_dev

# 予約実行対象を確認する間隔（秒）です。
SCHEDULER_POLL_INTERVAL_SECONDS=10

# 1回の確認で取得する予約実行の最大件数です。
SCHEDULER_BATCH_SIZE=20

# 同時に処理するDiscord送信の最大件数です。
SCHEDULER_MAX_CONCURRENCY=5

# 送信開始前に取得した処理権が期限切れになるまでの秒数です。
SCHEDULER_PROCESSING_TIMEOUT_SECONDS=120
